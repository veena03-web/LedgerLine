generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Application roles
enum UserRole {
  ADMIN
  ACCOUNT_HOLDER
  AUDITOR
}

// Customer account states
enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

// Types of financial transactions
enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

// Transaction processing states
enum TransactionStatus {
  PENDING
  POSTED
  REJECTED
  FAILED
}

// Debit or credit
enum EntrySide {
  DEBIT
  CREDIT
}

// Types of accounting accounts
enum LedgerAccountType {
  CUSTOMER
  CASH_CLEARING
}

// User information
model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
    role         UserRole @default(ACCOUNT_HOLDER)
  isActive     Boolean  @default(true)
  tokenVersion Int      @default(0)

  accounts     Account[]
  transactions Transaction[]
  auditEvents  AuditEvent[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  ledgerEntries LedgerEntry[]
}

// Customer accounts
model Account {
  id            String        @id @default(uuid()) @db.Uuid
  ownerId       String        @db.Uuid
  accountNumber String        @unique @db.VarChar(30)
  balancePaise  BigInt        @default(0)
  currency      String        @default("INR") @db.VarChar(3)
  status        AccountStatus @default(ACTIVE)

  owner           User          @relation(fields: [ownerId], references: [id])
  ledgerAccountId String        @unique @db.Uuid
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id])

  outgoingTransactions Transaction[] @relation("SourceAccount")
  incomingTransactions Transaction[] @relation("DestinationAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Customer and system accounting accounts
model LedgerAccount {
  id   String            @id @default(uuid()) @db.Uuid
  code String            @unique @db.VarChar(50)
  name String            @db.VarChar(100)
  type LedgerAccountType

  customerAccount Account?
  entries         LedgerEntry[]

  createdAt DateTime @default(now())
}

// Transaction request and outcome
model Transaction {
  id                   String          @id @default(uuid()) @db.Uuid
  type                 TransactionType
  amountPaise          BigInt
  sourceAccountId      String?         @db.Uuid
  destinationAccountId String?         @db.Uuid
  initiatedById        String          @db.Uuid

  idempotencyKey String @db.VarChar(128)
  requestHash    String @db.VarChar(128)

  status        TransactionStatus @default(PENDING)
  failureCode   String?
  failureReason String?
  description   String?           @db.VarChar(200)

  sourceAccount      Account? @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount Account? @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  initiatedBy        User     @relation(fields: [initiatedById], references: [id])

  entries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([initiatedById, idempotencyKey])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([createdAt])
}

// Actual posted debit and credit records
model LedgerEntry {
  id              String @id @default(uuid()) @db.Uuid
  transactionId   String @db.Uuid
  ledgerAccountId String @db.Uuid
  initiatedById   String @db.Uuid

  lineNumber        Int
  side              EntrySide
  amountPaise       BigInt
  balanceAfterPaise BigInt?

  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id])
  initiatedBy   User          @relation(fields: [initiatedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([transactionId, lineNumber])
  @@index([ledgerAccountId, createdAt])
}

// Security and administrative activity
model AuditEvent {
  id         String  @id @default(uuid()) @db.Uuid
  actorId    String? @db.Uuid
  action     String  @db.VarChar(100)
  targetType String? @db.VarChar(100)
  targetId   String?
  metadata   Json?
  ipAddress  String? @db.VarChar(45)

  actor User? @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
